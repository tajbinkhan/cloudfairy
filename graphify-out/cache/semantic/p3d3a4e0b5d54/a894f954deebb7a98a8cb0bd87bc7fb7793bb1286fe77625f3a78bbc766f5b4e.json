{"nodes": [{"id": "assets_readme_app_dark", "label": "Cloudfairy Dark Mode Screenshot", "file_type": "image", "source_file": "assets/readme/app-dark.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "README hero screenshot showing the single-window app in dark theme with three tunnels in different lifecycle states (live, starting, stopped) so readers see every state at once."}, {"id": "assets_readme_app_dark_header", "label": "App Header (Logo + cloudflared Version Badge + Settings)", "file_type": "image", "source_file": "assets/readme/app-dark.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Top bar with orange cloud logo, a green-dot pill showing the installed cloudflared version (2026.10.7), and a gear icon for settings; surfaces binary health at a glance."}, {"id": "assets_readme_app_dark_cloudflared_version_badge", "label": "cloudflared Version Status Pill", "file_type": "image", "source_file": "assets/readme/app-dark.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Green dot indicates cloudflared binary is detected and ready; ties to the app's cloudflared update-check feature."}, {"id": "assets_readme_app_dark_create_tunnel_form", "label": "Create Tunnel Form", "file_type": "image", "source_file": "assets/readme/app-dark.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Minimal inputs: local port or address (accepts bare port like 3000 or host:port) and optional name, plus a gradient orange primary 'Create tunnel' button; low-friction quick tunnel creation."}, {"id": "assets_readme_app_dark_tunnel_card", "label": "Tunnel Card", "file_type": "image", "source_file": "assets/readme/app-dark.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each tunnel is a card with name, local URL in monospace, status indicator, Start/Stop toggle, URL panel, collapsible Logs, and Edit/Remove actions; the live card gets a green border to stand out."}, {"id": "assets_readme_app_dark_status_indicator", "label": "Tunnel Status Indicator (Live / Getting a URL / Stopped)", "file_type": "image", "source_file": "assets/readme/app-dark.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Color-coded dot plus text: green Live with uptime and connection count, amber 'Getting a URL...', grey Stopped; conveys tunnel lifecycle state."}, {"id": "assets_readme_app_dark_public_url_panel", "label": "Public trycloudflare.com URL Panel", "file_type": "image", "source_file": "assets/readme/app-dark.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shows the generated quick-tunnel URL in monospace with copy, open-in-browser and QR code buttons; placeholder text when starting or stopped."}, {"id": "assets_readme_app_dark_local_server_warning", "label": "Local Server Not Responding Warning", "file_type": "image", "source_file": "assets/readme/app-dark.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Amber banner explaining nothing is answering on the local port so the public URL will error until the server runs; proactive, plain-language guidance."}, {"id": "assets_readme_app_dark_start_stop_control", "label": "Start/Stop Tunnel Control", "file_type": "image", "source_file": "assets/readme/app-dark.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Neutral Stop button for running tunnels, accent-colored Start button for stopped ones, so the primary action is visually emphasized."}, {"id": "assets_readme_app_dark_logs_toggle", "label": "Collapsible Logs + Edit/Remove Actions", "file_type": "image", "source_file": "assets/readme/app-dark.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Logs hidden by default behind a chevron to keep cards compact; Edit is disabled while a tunnel runs, enabled when stopped."}, {"id": "assets_readme_app_dark_dark_theme", "label": "Dark Theme Design", "file_type": "concept", "source_file": "assets/readme/app-dark.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Near-black surfaces with subtle borders, orange-to-pink gradient accent, and green/amber/grey semantic status colors."}, {"id": "assets_readme_app_dark_quick_tunnel_concept", "label": "Cloudflare Quick Tunnel", "file_type": "concept", "source_file": "assets/readme/app-dark.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The app exposes localhost ports via cloudflared quick tunnels yielding random *.trycloudflare.com URLs."}], "edges": [{"source": "assets_readme_app_dark", "target": "assets_readme_app_dark_header", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "assets/readme/app-dark.png", "source_location": null, "weight": 1.0}, {"source": "assets_readme_app_dark_header", "target": "assets_readme_app_dark_cloudflared_version_badge", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "assets/readme/app-dark.png", "source_location": null, "weight": 1.0}, {"source": "assets_readme_app_dark", "target": "assets_readme_app_dark_create_tunnel_form", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "assets/readme/app-dark.png", "source_location": null, "weight": 1.0}, {"source": "assets_readme_app_dark", "target": "assets_readme_app_dark_tunnel_card", "re