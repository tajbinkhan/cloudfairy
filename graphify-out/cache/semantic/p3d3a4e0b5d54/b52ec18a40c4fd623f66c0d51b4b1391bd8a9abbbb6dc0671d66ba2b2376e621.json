{"nodes": [{"id": "assets_readme_app_light", "label": "Cloudfairy Light Mode Screenshot", "file_type": "image", "source_file": "assets/readme/app-light.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "README hero screenshot showing the single-window app with three example tunnels in different states (Live, Getting a URL, Stopped) so readers see the whole tunnel lifecycle at a glance."}, {"id": "assets_readme_app_light_header_bar", "label": "App Header (logo, cloudflared status, settings)", "file_type": "image", "source_file": "assets/readme/app-light.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Top bar with orange cloud logo and 'Cloudfairy' wordmark on the left, binary status and settings on the right; keeps global state separate from per-tunnel cards."}, {"id": "assets_readme_app_light_cloudflared_status_pill", "label": "cloudflared Version Status Pill", "file_type": "image", "source_file": "assets/readme/app-light.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Green dot plus 'cloudflared 2026.10.7' confirms the bundled/installed cloudflared binary is available and shows its version (ties to the cloudflared update check)."}, {"id": "assets_readme_app_light_settings_button", "label": "Settings Gear Button", "file_type": "image", "source_file": "assets/readme/app-light.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "assets_readme_app_light_create_tunnel_form", "label": "Create Tunnel Form", "file_type": "image", "source_file": "assets/readme/app-light.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Minimal input: 'Local port or address' (accepts bare port like 3000 or host:port like localhost:5173), optional Name, and a gradient orange 'Create tunnel' primary button; designed for one-step quick tunnel creation."}, {"id": "assets_readme_app_light_tunnel_card", "label": "Tunnel Card", "file_type": "image", "source_file": "assets/readme/app-light.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One card per tunnel (examples: Storefront :3000, Docs site :8080, API :8000) with name, local URL in monospace, status, public URL area and footer actions; the live card gets a green border to stand out."}, {"id": "assets_readme_app_light_tunnel_status_indicator", "label": "Tunnel Status Indicator (Live / Getting a URL / Stopped)", "file_type": "image", "source_file": "assets/readme/app-light.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Color-coded dot and text: green 'Live \u00b7 12m 36s \u00b7 4 connections' shows uptime and connection count, amber 'Getting a URL...' while waiting on Cloudflare, gray 'Stopped' when idle."}, {"id": "assets_readme_app_light_public_url_bar", "label": "Public trycloudflare URL Bar", "file_type": "image", "source_file": "assets/readme/app-light.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shows the generated *.trycloudflare.com quick-tunnel URL with copy, open-in-browser and QR code icon buttons; falls back to placeholder text ('Asking Cloudflare for a public URL...', 'Start the tunnel to get a public URL.') in other states."}, {"id": "assets_readme_app_light_local_server_warning", "label": "Local Server Not Answering Warning", "file_type": "image", "source_file": "assets/readme/app-light.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Amber banner explaining that nothing answers on localhost:8080 so the public URL will show an error page until the local server runs; plain-language guidance instead of raw errors."}, {"id": "assets_readme_app_light_tunnel_actions", "label": "Tunnel Actions (Start/Stop, Edit, Remove)", "file_type": "image", "source_file": "assets/readme/app-light.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stop is a neutral outlined button while running; Start uses the orange gradient primary style when stopped. Edit is greyed out while a tunnel runs and enabled only when stopped."}, {"id": "assets_readme_app_light_logs_toggle", "label": "Collapsible Logs Toggle", "file_type": "image", "source_file": "assets/readme/app-light.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-tunnel cloudflared logs hidden behind a chevron disclosure to keep cards compact."}, {"id": "assets_readme_app_light_light_theme", "label": "Light Theme Visual Style", "file_type": "concept", "source_file": "assets/readme/app-light.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Warm off-white background, white rounded cards, orange-to-pink gradient accent for primary actions, semantic green/amber/gray status colors; a light-mode counterpart to a dark-mode screenshot."}], "edges": [{"source": "assets_readme_app_light", "target": "assets_readme_app_light_header_bar", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "assets/readme/app-light.png", "source_location": null, "weight": 1.0}, {"source": "assets_readme_app_light", "target": "assets_readme_app_light_create_tunnel_form", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "assets/readme/app-light.png", "source_location": null, "weight": 1.0}, {"source": "assets_readme_app_light", "target": "assets_readme_app_light_tunnel_card", "relation": "references", "