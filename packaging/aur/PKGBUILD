# Maintainer: Tajbin Khan <https://github.com/tajbinkhan>
pkgname=cloudfairy-bin
_pkgname=cloudfairy
pkgver=@VERSION@
pkgrel=1
pkgdesc="Share a local port to the internet with Cloudflare quick tunnels"
arch=('x86_64')
url="https://tajbinkhan.github.io/cloudfairy/"
license=('MIT')
depends=('gtk3' 'libayatana-appindicator' 'webkit2gtk-4.1')
optdepends=('cloudflared: use the system copy instead of the one Cloudfairy downloads')
provides=("$_pkgname")
conflicts=("$_pkgname")
options=('!strip' '!debug')
source=("$_pkgname-$pkgver.deb::https://github.com/tajbinkhan/cloudfairy/releases/download/v$pkgver/Cloudfairy_${pkgver}_amd64.deb"
        "LICENSE-$pkgver::https://raw.githubusercontent.com/tajbinkhan/cloudfairy/v$pkgver/LICENSE")
sha256sums=('@DEB_SHA256@'
            '@LICENSE_SHA256@')

package() {
  bsdtar -xf data.tar.* -C "$pkgdir"
  install -Dm644 "LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
