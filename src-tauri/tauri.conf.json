{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cloudfairy",
  "version": "0.2.0",
  "identifier": "dev.cloudfairy.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Cloudfairy",
        "width": 980,
        "height": 720,
        "minWidth": 600,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "Share a local port to the internet with Cloudflare quick tunnels",
    "longDescription": "Cloudfairy is a desktop app for Cloudflare quick tunnels. Type a local port and get a public https://….trycloudflare.com link, without running cloudflared in a terminal. Run several tunnels at once, copy the link or show a QR code, and watch live cloudflared logs. No Cloudflare account needed.",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["cloudfairy"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY3RDZDNDNFMjlFM0RFQkQKUldTOTN1TXBQc1RXOXgwZjFuNktoOGdxNEZucUlnYVpLeWt6bXUwalN0ZDJvZlBER25ZbjZxclYK",
      "endpoints": [
        "https://github.com/tajbinkhan/cloudfairy/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
